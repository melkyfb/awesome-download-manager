{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awesome Download Manager",
  "version": "0.1.0",
  "identifier": "com.melkyfb.awesomedownloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Awesome Download Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMTE1NkM2MzY0QTdBNjQKUldSa2VrbzJ4bFlSbzRrYXo4cHVXRTI5ZFBiSG80b3JVNlh0bk5NVzRDL3hmTHNSSVNvdHJqZFoK",
      "endpoints": [
        "https://github.com/melkyfb/awesome-download-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
